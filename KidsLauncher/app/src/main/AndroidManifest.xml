<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Только для экспорта списка приложений в папку Download (этап 1). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <!-- Этап 2: главный экран лаунчера (HOME + DEFAULT). -->
        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Чтобы лаунчер можно было открыть из стандартного лаунчера при первой настройке. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Этап 1: разведка — список всех запускаемых приложений. -->
        <activity
            android:name=".AppListActivity"
            android:exported="true"
            android:label="@string/app_list_label"
            android:screenOrientation="portrait"
            android:taskAffinity="com.nikole.kidslauncher.applist">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PinActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ParentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>
</manifest>
