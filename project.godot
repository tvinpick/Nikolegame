; Engine configuration file.
; Godot 4.7.2 Stable — see README.md / ENGINE_VERSION

config_version=5

[application]

config/name="Мой сказочный домик"
config/description="Уютная 2.5D игра-комната для ребёнка 6 лет"
config/version="0.7.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.98, 0.9, 0.92, 1)
boot_splash/show_image=false
config/auto_accept_quit=false
config/quit_on_go_back=false

[audio]

general/text_to_speech=true
driver/enable_input=false

[autoload]

Loc="*res://scripts/core/loc.gd"
Content="*res://scripts/core/content.gd"
Diag="*res://scripts/diagnostics/diagnostics.gd"
GameState="*res://scripts/core/game_state.gd"
Save="*res://scripts/save/save_service.gd"
Economy="*res://scripts/inventory/economy.gd"
AudioSvc="*res://scripts/audio/audio_service.gd"
Learning="*res://scripts/learning/learning_service.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray("res://addons/game_recorder/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/Inter-SemiBold.otf"
theme/default_font_antialiasing=1
common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=1
2d/snap/snap_2d_transforms_to_pixel=false
environment/defaults/default_clear_color=Color(0.98, 0.93, 0.9, 1)
