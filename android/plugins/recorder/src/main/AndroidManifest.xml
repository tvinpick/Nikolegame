<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Screen capture needs a foreground service of type mediaProjection (Android 14+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- NOTE: no RECORD_AUDIO. The game mix is recorded inside Godot (AudioEffectRecord),
         so the microphone is never used and never requested. -->

    <application>
        <meta-data
            android:name="org.godotengine.plugin.v2.GameRecorder"
            android:value="com.nikole.recorder.GameRecorderPlugin" />

        <service
            android:name="com.nikole.recorder.RecorderService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.gamerecorder.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/gamerecorder_file_paths" />
        </provider>
    </application>
</manifest>
